# Copy to .env (gitignored) and fill in real values locally if ever needed.
# Nothing in this repo's Docker/Make setup requires a .env file to build or
# run the baseline — this file exists only to document the one env var the
# codebase itself references.

# Cypress Cloud recording key. Placeholder only — never the real value.
# A real value is already known to be exposed (committed in plaintext inside
# package.json's "dashboard:cy" script, across multiple commits in this
# repo's history) — tracked as a parked Gate 1 item in
# projects/info/state/APPROVALS.md, pending rotation by the repo owner. Do
# not fill this file with that value, do not reference it from any new file
# added in this phase, and do not run `npm run dashboard:cy` / `report:ci` /
# `report:local` against a container built from this Dockerfile.
CYPRESS_RECORD_KEY=
