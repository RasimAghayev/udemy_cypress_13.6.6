# Dependencies
/node_modules

# Environment / secrets — never commit real values
.env
.env.*
!.env.example

# Cypress generated artifacts (reports, videos, screenshots, downloads)
cypress/reports/
cypress/videos/
cypress/screenshots/
cypress/downloads/
cypress/test-results/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS junk
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# gitleaks scratch/report files (generated by the pre-commit hook / manual runs)
gitleaks-report.json
.gitleaks-staged-tmp/
